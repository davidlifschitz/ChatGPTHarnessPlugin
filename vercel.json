{
  "functions": {
    "api/mcp.js": { "maxDuration": 180 },
    "api/oauth.js": { "maxDuration": 90 },
    "api/operator.js": { "maxDuration": 90 },
    "api/native-bootstrap.js": { "maxDuration": 180 }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?route=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/oauth?route=/.well-known/oauth-protected-resource/mcp"
    },
    {
      "source": "/mcp/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?route=/mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?route=/.well-known/oauth-authorization-server"
    },
    {
      "source": "/oauth/:operation",
      "destination": "/api/oauth?route=/oauth/:operation"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
